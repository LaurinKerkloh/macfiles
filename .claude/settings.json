{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "dark",
  "editorMode": "vim",
  "permissions": {
    "ask": [
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)"
    ]
  }
}
