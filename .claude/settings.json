{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ],
    "ask": [
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(heroku)",
      "Bash(heroku *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.macfiles/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "language": "english",
  "editorMode": "vim",
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true
  }
}
