#!/usr/bin/env bash

set -euo pipefail

# Enable job control
set -m

VARIANT="${1:-}"

DIR_NAME="$(basename "$PWD")"
PROCFILE_DIR="$HOME/code/procfiles"

# Determine correct Procfile
if [[ -n "$VARIANT" ]]; then
    PROCFILE="$PROCFILE_DIR/Procfile.${DIR_NAME}_${VARIANT}"
else
    PROCFILE="$PROCFILE_DIR/Procfile.${DIR_NAME}"
fi

# Exit if no Procfile found
if [[ ! -f "$PROCFILE" ]]; then
    echo "Error: Procfile not found: $PROCFILE"
    exit 1
fi

# Delete associated Docker volumes after confirmation
read -r -p "Delete Docker volumes starting with '${DIR_NAME}'? (y/N): " confirm
case "$confirm" in
    [yY]|[yY][eE][sS])
        docker volume ls -q | grep "^${DIR_NAME}" | xargs -r docker volume rm || true
        ;;
    *)
        echo "Skipping Docker volume cleanup."
        ;;
esac

# Install all tools required by the project's mise/version files
echo "Installing mise tools..."
mise install

# Install JS packages with yarn (also for projects using npm)
if [[ -f package.json ]]; then
    if ! command -v yarn >/dev/null 2>&1; then
        echo "Installing yarn..."
        npm install -g yarn
        mise reshim
    fi
    echo "Installing JS packages..."
    yarn install
fi

# Install foreman if it doesn't exist
if $(gem list --no-installed --exact --silent foreman); then
    echo "Installing foreman..."
    gem install foreman
fi

# Run the initially needed services (can be configured with a <SERVICE_NAME>.setup_formation file)
FORMATION_FILE="$PROCFILE_DIR/${DIR_NAME}.setup_formation"
if [[ -f "$FORMATION_FILE" ]]; then
    FORMATION_CONTENTS="$(<"$FORMATION_FILE")"
    foreman start -f "$PROCFILE" -d "$PWD" -m "$FORMATION_CONTENTS" &
    SETUP_FORMATION_PID=$!
else
    foreman run -f "$PROCFILE" -d "$PWD" db &
    SETUP_FORMATION_PID=$!
fi

# On macOS, shim commands that project setup scripts assume from Linux
SHIM_DIR="$(mktemp -d)"
if [[ "$(uname)" == "Darwin" ]]; then
    # Redirect copies into Linux font dirs to the user's font dir
    cat > "$SHIM_DIR/cp" <<'EOF'
#!/usr/bin/env bash
args=()
for arg in "$@"; do
    [[ "$arg" == /usr/share/fonts* ]] && arg="$HOME/Library/Fonts/"
    args+=("$arg")
done
exec /bin/cp "${args[@]}"
EOF
    # macOS picks up new fonts by itself, so fc-cache is optional
    if ! command -v fc-cache >/dev/null 2>&1; then
        printf '#!/usr/bin/env bash\nexit 0\n' > "$SHIM_DIR/fc-cache"
    fi
    chmod +x "$SHIM_DIR"/*
fi

cleanup() {
    kill -TERM -- "-$SETUP_FORMATION_PID" 2>/dev/null || true
    wait "$SETUP_FORMATION_PID" 2>/dev/null || true
    rm -rf "$SHIM_DIR"
}
trap cleanup SIGINT SIGTERM EXIT

echo "Giving the setup formation some time to start up..."
sleep 5

PATH="$SHIM_DIR:$PATH" bin/setup --skip-server
