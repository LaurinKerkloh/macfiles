[user]
    name = Laurin Kerkloh
    email = laurin@nerdgeschoss.de
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
[rerere]
    enabled = true
[pull]
	rebase = false
[init]
	defaultBranch = main
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
